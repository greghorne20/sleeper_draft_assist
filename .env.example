# Copy to .env. Anything already exported wins, so a real environment variable
# is never overridden by this file.

# The league to work against. Every command takes --league-id too; this is the
# default so you stop typing it. sleeper-live uses it only to name the twelve
# seats -- without it they are numbered.
SLEEPER_LEAGUE_ID=

# The draft sleeper-live polls. Required: the committed board carries the
# league's shape but not its ids, because league_id is a lookup key into a
# public API and this repo is published. sleeper-discover prints yours.
SLEEPER_DRAFT_ID=

# Only needed by sleeper-discover when you do not know the league id yet.
SLEEPER_USERNAME=
SLEEPER_SEASON=2026

# Your draft slot, for sleeper-live. Leave empty and the pick-timing maths is
# skipped rather than guessed.
SLEEPER_SLOT=

# Optional: without it sleeper-warroom does not run and the page renders
# without the brief panel. Nothing else needs a key.
ANTHROPIC_API_KEY=
